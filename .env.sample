# Copy to .env and fill in. .env is gitignored; never commit real values.
NODE_ENV=development
PORT=3503
MONGODB_URI=mongodb://localhost:27017/webaudit
LOG_LEVEL=info
AUDIT_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
# Proxies in front of the app (1 on Cloud Run / Railway). 0 when clients connect directly.
TRUST_PROXY_HOPS=1
# Chrome for Lighthouse; leave empty to let chrome-launcher find it.
CHROME_PATH=

# AI insights (optional). Any OpenAI-compatible endpoint. Leave LLM_BASE_URL empty to turn insights off.
# OpenRouter: https://openrouter.ai/api/v1   Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
# Pick a current free model with: npm run llm:free-models
LLM_MODEL=
# OpenRouter only: comma-separated models to try when LLM_MODEL is rate-limited or down.
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_MS=120000
LLM_APP_URL=
INSIGHTS_RATE_LIMIT_WINDOW_MS=3600000
INSIGHTS_RATE_LIMIT_MAX=5
